// SPDX-License-Identifier: GPL-2.0-only
/*
 * Recon Instruments Jet (OMAP4430 ES2.3 GP, TWL6032) — milestone 1 device tree.
 * Wiring taken from the ReconOS 3.0 kernel board files (board-4430jet.c,
 * board-44xx-power.c) and the x-loader pinmux table. Display, camera, WiFi,
 * audio and sensors are left out on purpose for the first boot.
 */
/dts-v1/;

#include <dt-bindings/input/input.h>
#include <dt-bindings/gpio/gpio.h>
#include "omap443x.dtsi"

/ {
	model = "Recon Instruments Jet";
	compatible = "recon,jet", "ti,omap4430", "ti,omap4";

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x40000000>; /* 1 GiB */
	};

	chosen {
		/* panic=5: reboot into fastboot/stock instead of hanging; early_enable: arm the
		 * hardware watchdog at driver probe so a hang before init still resets */
		bootargs = "loglevel=8 ignore_loglevel panic=5 omap_wdt.early_enable=1";
	};

	/* crash/console log that survives a reset (read back from /sys/fs/pstore) */
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* u-boot's ATAG memory ends at 0xbe2e1000 (1,018,180 kB), keep this below it */
		ramoops@bd000000 {
			compatible = "ramoops";
			reg = <0xbd000000 0x100000>;
			record-size = <0x8000>;
			console-size = <0x80000>;
			pmsg-size = <0x8000>;
			ftrace-size = <0>;
		};
	};

	/* Kopin A230 microdisplay on the RFBI (MIPI DBI) bus. GPIOs from the stock board file:
	 * power = gpio 52 (gpmc_ncs2), reset = gpio 42 (gpmc_a18), clk-en = gpio 41 (gpmc_a17),
	 * a16 = gpio 163 (usbb2_ulpitll_dat2). Pixel clock = auxclk4 (fref_clk4_out) at 36.57 MHz (256 MHz / 7, from the stock registers). */
	panel: panel {
		compatible = "recon,kopin-a230";
		pinctrl-names = "default";
		pinctrl-0 = <&kopin_gpio_pins>, <&kopin_clk_pins>;
		power-gpios = <&gpio2 20 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio2 10 GPIO_ACTIVE_HIGH>;
		clk-en-gpios = <&gpio2 9 GPIO_ACTIVE_HIGH>;
		a16-gpios = <&gpio6 3 GPIO_ACTIVE_HIGH>;
		/* stock: dpll_per m3x2 = 256 MHz, auxclk4 = 256/7 = 36.57 MHz. The driver sets the
		 * rate itself (assigned-clocks on these made the probe defer forever). */
		clocks = <&auxclk4_ck>, <&auxclk4_src_ck>, <&dpll_per_m3x2_ck>;
		clock-names = "pixel", "pixel_src", "per_m3";

		port {
			kopin_in: endpoint {
				remote-endpoint = <&rfbi_out>;
			};
		};
	};

	/* BUTTON_1 on the pod: uart3_rx_irrx pad as gpio_143 (gpio5 line 15), idle high,
	 * stock jet-keys reported KEY_102ND (86) on a short click */
	/* power-button LED: TWL6032 PWM2 (stock u-boot/kernel: PWM2ON 0x60, PWM2OFF 0x7f, TOGGLE3
	 * clock+signal enable). twl6030.dtsi's twl_pwm id 1 = PWM2; polarity checked by eye. */
	pwmleds {
		compatible = "pwm-leds";
		led-power {
			label = "jet:white:power";
			pwms = <&twl_pwm 1 7812500>;
			max-brightness = <127>;
			default-state = "keep";
		};
	};

	dmic_codec: dmic-codec {
		compatible = "dmic-codec";
		#sound-dai-cells = <0>;
		num-channels = <2>;
	};

	sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "Jet";
		#address-cells = <1>;
		#size-cells = <0>;
		simple-audio-card,dai-link@0 {		/* speaker: McBSP2 I2S master -> TFA9895 */
			reg = <0>;
			format = "i2s";
			bitclock-master = <&jet_cpu_dai>;
			frame-master = <&jet_cpu_dai>;
			jet_cpu_dai: cpu {
				sound-dai = <&mcbsp2>;
			};
			codec {
				sound-dai = <&tfa9895>;
			};
		};
		simple-audio-card,dai-link@1 {		/* mics: OMAP4 DMIC -> generic dmic codec */
			reg = <1>;
			cpu {
				sound-dai = <&dmic>;
			};
			codec {
				sound-dai = <&dmic_codec>;
			};
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&button_pins>;
		button-1 {
			label = "BUTTON_1";
			gpios = <&gpio5 15 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_102ND>;
			debounce-interval = <50>;
			wakeup-source;
		};
	};

	/* the pack rg fitted: a generic 3.7 V 500 mAh cell on the Recon protection board */
	battery: battery {
		compatible = "simple-battery";
		device-chemistry = "lithium-ion";
		charge-full-design-microamp-hours = <500000>;
		voltage-max-design-microvolt = <4200000>;
		voltage-min-design-microvolt = <3300000>;
		constant-charge-voltage-max-microvolt = <4200000>;
		constant-charge-current-max-microamp = <400000>;
		charge-term-current-microamp = <50000>;
	};

	/* The WL1283 needs the PMIC's CLK32KG 32 kHz output (CFG_STATE 0x48:0xBE); after a real
	 * power-on it is off and SDIO init fails ("Failed to initialize a non-removable card"), every
	 * earlier run inherited Android's setting. Keep it on from boot. */
	clk32kg_keeper: regulator-clk32kg {
		compatible = "regulator-fixed-clock";
		regulator-name = "clk32kg";
		clocks = <&twl 0>;
		regulator-always-on;
		regulator-boot-on;
	};

	/* WL128x power: GPIO43 (gpmc_a19) = gpio2 line 11 */
	wl12xx_vmmc: regulator-wl12xx {
		pinctrl-names = "default";
		pinctrl-0 = <&wl12xx_gpio>;
		compatible = "regulator-fixed";
		regulator-name = "vwl1271";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&gpio2 11 GPIO_ACTIVE_HIGH>;
		startup-delay-us = <70000>;
		enable-active-high;
	};
};

&omap4_pmx_wkup {
	kopin_clk_pins: pinmux-kopin-clk-pins {
		pinctrl-single,pins = <
			OMAP4_IOPAD(0x05c, PIN_OUTPUT | MUX_MODE0)	/* fref_clk4_out (36.57 MHz to the Kopin), wkup domain */
		>;
	};
};

&omap4_pmx_core {
	wl12xx_gpio: wl12xx-gpio-pins {
		pinctrl-single,pins = <
			OMAP4_IOPAD(0x066, PIN_OUTPUT | MUX_MODE3)		/* gpmc_a19.gpio_43 - WLAN_EN */
		>;
	};

	uart2_pins: uart2-pins {		/* WL1283 BT HCI (stock: ttyO1 = uart2, 3.6864 Mbaud, flow control) */
		pinctrl-single,pins = <
			OMAP4_IOPAD(0x118, PIN_INPUT_PULLUP | MUX_MODE0)	/* uart2_cts */
			OMAP4_IOPAD(0x11a, PIN_OUTPUT | MUX_MODE0)		/* uart2_rts */
			OMAP4_IOPAD(0x11c, PIN_INPUT_PULLUP | MUX_MODE0)	/* uart2_rx */
			OMAP4_IOPAD(0x11e, PIN_OUTPUT | MUX_MODE0)		/* uart2_tx */
		>;
	};

	bt_pins: bt-pins {
		pinctrl-single,pins = <
			OMAP4_IOPAD(0x06c, PIN_OUTPUT | MUX_MODE3)		/* gpmc_a22.gpio_46 - BT_EN */
		>;
	};

	dmic_pins: dmic-pins {			/* digital mics: DMIC block clock out + din1 (stock ABE route DMic0L/R) */
		pinctrl-single,pins = <
			OMAP4_IOPAD(0x110, PIN_OUTPUT | MUX_MODE0)		/* abe_dmic_clk1 */
			OMAP4_IOPAD(0x112, PIN_INPUT | MUX_MODE0)		/* abe_dmic_din1 */
		>;
	};

	mcbsp2_pins: mcbsp2-pins {		/* I2S to the TFA9895 speaker amp (stock jet V2 mux) */
		pinctrl-single,pins = <
			OMAP4_IOPAD(0x0f6, PIN_OUTPUT | MUX_MODE0)		/* abe_mcbsp2_clkx */
			OMAP4_IOPAD(0x0f8, PIN_INPUT | MUX_MODE0)		/* abe_mcbsp2_dr */
			OMAP4_IOPAD(0x0fa, PIN_OUTPUT | MUX_MODE0)		/* abe_mcbsp2_dx */
			OMAP4_IOPAD(0x0fc, PIN_OUTPUT | MUX_MODE0)		/* abe_mcbsp2_fsx */
		>;
	};

	wl12xx_pins: wl12xx-pins {
		pinctrl-single,pins = <
			OMAP4_IOPAD(0x07a, PIN_INPUT | MUX_MODE3)		/* gpmc_ncs3.gpio_53 - WLAN_IRQ */
			OMAP4_IOPAD(0x148, PIN_INPUT_PULLUP | MUX_MODE0)	/* sdmmc5_clk */
			OMAP4_IOPAD(0x14a, PIN_INPUT_PULLUP | MUX_MODE0)	/* sdmmc5_cmd */
			OMAP4_IOPAD(0x14c, PIN_INPUT_PULLUP | MUX_MODE0)	/* sdmmc5_dat0 */
			OMAP4_IOPAD(0x14e, PIN_INPUT_PULLUP | MUX_MODE0)	/* sdmmc5_dat1 */
			OMAP4_IOPAD(0x150, PIN_INPUT_PULLUP | MUX_MODE0)	/* sdmmc5_dat2 */
			OMAP4_IOPAD(0x152, PIN_INPUT_PULLUP | MUX_MODE0)	/* sdmmc5_dat3 */
		>;
	};

	i2c1_pins: pinmux-i2c1-pins {
		pinctrl-single,pins = <
			OMAP4_IOPAD(0x122, PIN_INPUT_PULLUP | MUX_MODE0)	/* i2c1_scl */
			OMAP4_IOPAD(0x124, PIN_INPUT_PULLUP | MUX_MODE0)	/* i2c1_sda */
		>;
	};

	/* eMMC on MMC2: gpmc_ad0..7 / gpmc_noe / gpmc_nwe in mode 1 (from x-loader) */
	mmc2_pins: pinmux-mmc2-pins {
		pinctrl-single,pins = <
			OMAP4_IOPAD(0x040, PIN_INPUT_PULLUP | MUX_MODE1)	/* sdmmc2_dat0 */
			OMAP4_IOPAD(0x042, PIN_INPUT_PULLUP | MUX_MODE1)	/* sdmmc2_dat1 */
			OMAP4_IOPAD(0x044, PIN_INPUT_PULLUP | MUX_MODE1)	/* sdmmc2_dat2 */
			OMAP4_IOPAD(0x046, PIN_INPUT_PULLUP | MUX_MODE1)	/* sdmmc2_dat3 */
			OMAP4_IOPAD(0x048, PIN_INPUT_PULLUP | MUX_MODE1)	/* sdmmc2_dat4 */
			OMAP4_IOPAD(0x04a, PIN_INPUT_PULLUP | MUX_MODE1)	/* sdmmc2_dat5 */
			OMAP4_IOPAD(0x04c, PIN_INPUT_PULLUP | MUX_MODE1)	/* sdmmc2_dat6 */
			OMAP4_IOPAD(0x04e, PIN_INPUT_PULLUP | MUX_MODE1)	/* sdmmc2_dat7 */
			OMAP4_IOPAD(0x082, PIN_INPUT_PULLUP | MUX_MODE1)	/* sdmmc2_clk */
			OMAP4_IOPAD(0x084, PIN_INPUT_PULLUP | MUX_MODE1)	/* sdmmc2_cmd */
		>;
	};

	/* RFBI bus, values read back from the stock kernel's omap_mux debugfs (2026-10-17):
	 * data/control pads are bidirectional (input buffer enabled), dpm_emu6 is gpio_17 */
	rfbi_pins: pinmux-rfbi-pins {
		pinctrl-single,pins = <
			OMAP4_IOPAD(0x1b4, PIN_INPUT | MUX_MODE4)	/* dpm_emu3.rfbi_data10 */
			OMAP4_IOPAD(0x1b6, PIN_INPUT | MUX_MODE4)	/* dpm_emu4.rfbi_data9 */
			OMAP4_IOPAD(0x1b8, PIN_INPUT | MUX_MODE4)	/* dpm_emu5.rfbi_te_vsync0 */
			OMAP4_IOPAD(0x1ba, PIN_OUTPUT | MUX_MODE3)	/* dpm_emu6.gpio_17 (stock, not hsync) */
			OMAP4_IOPAD(0x1bc, PIN_INPUT | MUX_MODE4)	/* dpm_emu7.rfbi_cs0 */
			OMAP4_IOPAD(0x1be, PIN_INPUT | MUX_MODE4)	/* dpm_emu8.rfbi_re */
			OMAP4_IOPAD(0x1c0, PIN_INPUT | MUX_MODE4)	/* dpm_emu9.rfbi_we */
			OMAP4_IOPAD(0x1c2, PIN_INPUT | MUX_MODE4)	/* dpm_emu10.rfbi_a0 */
			OMAP4_IOPAD(0x1c4, PIN_INPUT | MUX_MODE4)	/* dpm_emu11.rfbi_data8 */
			OMAP4_IOPAD(0x1c6, PIN_INPUT | MUX_MODE4)	/* dpm_emu12.rfbi_data7 */
			OMAP4_IOPAD(0x1c8, PIN_INPUT | MUX_MODE4)	/* dpm_emu13.rfbi_data6 */
			OMAP4_IOPAD(0x1ca, PIN_INPUT | MUX_MODE4)	/* dpm_emu14.rfbi_data5 */
			OMAP4_IOPAD(0x1cc, PIN_INPUT | MUX_MODE4)	/* dpm_emu15.rfbi_data4 */
			OMAP4_IOPAD(0x1ce, PIN_INPUT | MUX_MODE4)	/* dpm_emu16.rfbi_data3 */
			OMAP4_IOPAD(0x1d0, PIN_INPUT | MUX_MODE4)	/* dpm_emu17.rfbi_data2 */
			OMAP4_IOPAD(0x1d2, PIN_INPUT | MUX_MODE4)	/* dpm_emu18.rfbi_data1 */
			OMAP4_IOPAD(0x1d4, PIN_INPUT | MUX_MODE4)	/* dpm_emu19.rfbi_data0 */
			OMAP4_IOPAD(0x16e, PIN_INPUT | MUX_MODE6)	/* usbb2_ulpitll_dat3.rfbi_data15 */
			OMAP4_IOPAD(0x170, PIN_INPUT | MUX_MODE6)	/* usbb2_ulpitll_dat4.rfbi_data14 */
			OMAP4_IOPAD(0x172, PIN_INPUT | MUX_MODE6)	/* usbb2_ulpitll_dat5.rfbi_data13 */
			OMAP4_IOPAD(0x174, PIN_INPUT | MUX_MODE6)	/* usbb2_ulpitll_dat6.rfbi_data12 */
			OMAP4_IOPAD(0x176, PIN_INPUT | MUX_MODE6)	/* usbb2_ulpitll_dat7.rfbi_data11 */
		>;
	};

	kopin_gpio_pins: pinmux-kopin-gpio-pins {
		pinctrl-single,pins = <
			OMAP4_IOPAD(0x062, PIN_OUTPUT | MUX_MODE3)	/* gpmc_a17.gpio_41 CLK_TV_EN */
			OMAP4_IOPAD(0x064, PIN_OUTPUT | MUX_MODE3)	/* gpmc_a18.gpio_42 DISP_RES */
			OMAP4_IOPAD(0x078, PIN_OUTPUT | MUX_MODE3)	/* gpmc_ncs2.gpio_52 POWER_ENABLE */
			OMAP4_IOPAD(0x16c, PIN_OUTPUT | MUX_MODE3)	/* usbb2_ulpitll_dat2.gpio_163 RFBI_A16 */
		>;
	};

	button_pins: pinmux-button-pins {
		pinctrl-single,pins = <
			OMAP4_IOPAD(0x144, PIN_INPUT_PULLUP | MUX_MODE3)	/* uart3_rx_irrx.gpio_143 BUTTON_1 */
		>;
	};

	i2c2_pins: pinmux-i2c2-pins {
		pinctrl-single,pins = <
			OMAP4_IOPAD(0x126, PIN_INPUT_PULLUP | MUX_MODE0)	/* i2c2_scl */
			OMAP4_IOPAD(0x128, PIN_INPUT_PULLUP | MUX_MODE0)	/* i2c2_sda */
		>;
	};

	i2c3_pins: pinmux-i2c3-pins {
		pinctrl-single,pins = <
			OMAP4_IOPAD(0x12a, PIN_INPUT_PULLUP | MUX_MODE0)	/* i2c3_scl */
			OMAP4_IOPAD(0x12c, PIN_INPUT_PULLUP | MUX_MODE0)	/* i2c3_sda */
		>;
	};

	/* Partron OFM touchpad: MOTION gpio_176 (kpd_row4), STANDBY gpio_49 (gpmc_a25), POWERDOWN gpio_37 (gpmc_ad13) */
	ofm_pins: pinmux-ofm-pins {
		pinctrl-single,pins = <
			OMAP4_IOPAD(0x18a, PIN_INPUT_PULLDOWN | MUX_MODE3)	/* kpd_row4.gpio_176 MOTION */
			OMAP4_IOPAD(0x072, PIN_OUTPUT | MUX_MODE3)		/* gpmc_a25.gpio_49 STANDBY */
			OMAP4_IOPAD(0x05a, PIN_OUTPUT | MUX_MODE3)		/* gpmc_ad13.gpio_37 POWERDOWN */
		>;
	};

	/* camera: MT9M114 on CSI-2 port A (csi21 dx0/dy0 = clock, dx1/dy1 = data 1), MCLK on fref_clk1_out.
	 * Pull-ups on the lanes so an unpowered sensor reads as LP-11 (the CSI-2 complex IO reset needs it;
	 * the bootloader had them on dx2/dy2).
	 * reset gpio_83 (cam_globalreset pad), power switch gpio_175 (kpd_row3) */
	cam_pins: pinmux-cam-pins {
		pinctrl-single,pins = <
			OMAP4_IOPAD(0x0a0, PIN_INPUT_PULLUP | MUX_MODE0)	/* csi21_dx0 */
			OMAP4_IOPAD(0x0a2, PIN_INPUT_PULLUP | MUX_MODE0)	/* csi21_dy0 */
			OMAP4_IOPAD(0x0a4, PIN_INPUT_PULLUP | MUX_MODE0)	/* csi21_dx1 */
			OMAP4_IOPAD(0x0a6, PIN_INPUT_PULLUP | MUX_MODE0)	/* csi21_dy1 */
			OMAP4_IOPAD(0x0a8, PIN_INPUT_PULLUP | MUX_MODE0)	/* csi21_dx2 (bootloader had these two muxed, so the module may use them) */
			OMAP4_IOPAD(0x0aa, PIN_INPUT_PULLUP | MUX_MODE0)	/* csi21_dy2 */
			OMAP4_IOPAD(0x0c0, PIN_OUTPUT | MUX_MODE3)	/* cam_globalreset.gpio_83 */
			OMAP4_IOPAD(0x19a, PIN_OUTPUT | MUX_MODE0)	/* fref_clk1_out (camera MCLK) */
			OMAP4_IOPAD(0x188, PIN_OUTPUT | MUX_MODE3)	/* kpd_row3.gpio_175 SW_CAM_ON */
		>;
	};

	i2c4_pins: pinmux-i2c4-pins {
		pinctrl-single,pins = <
			OMAP4_IOPAD(0x12e, PIN_INPUT_PULLUP | MUX_MODE0)	/* i2c4_scl */
			OMAP4_IOPAD(0x130, PIN_INPUT_PULLUP | MUX_MODE0)	/* i2c4_sda */
		>;
	};

	usb_otg_hs_pins: pinmux-usb-otg-hs-pins {
		pinctrl-single,pins = <
			OMAP4_IOPAD(0x194, PIN_OUTPUT_PULLDOWN | MUX_MODE0)	/* usba0_otg_ce */
			OMAP4_IOPAD(0x196, PIN_INPUT | MUX_MODE0)		/* usba0_otg_dp */
			OMAP4_IOPAD(0x198, PIN_INPUT | MUX_MODE0)		/* usba0_otg_dm */
		>;
	};
};

&i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pins>;
	clock-frequency = <400000>;

	twl: pmic@48 {
		compatible = "ti,twl6032";
		reg = <0x48>;
		#clock-cells = <1>;
		interrupts = <GIC_SPI 7 IRQ_TYPE_LEVEL_HIGH>; /* IRQ_SYS_1N cascaded to gic */
		interrupt-controller;
		#interrupt-cells = <1>;
		system-power-controller;

		/* rear pod button = PMIC PWRON: short press is the BACK/UP nav key in the stock UI
		 * (reported as KEY_END 107 there), long press is power. kernel/patches adds 6030 support. */
		pwrbutton {
			compatible = "ti,twl4030-pwrbutton";
			interrupts = <0>;
			linux,code = <KEY_END>;
		};

		charger {
			compatible = "ti,twl6032-charger", "ti,twl6030-charger";
			interrupts = <2>, <5>;
			io-channels = <&gpadc 10>;
			io-channel-names = "vusb";
			monitored-battery = <&battery>;
		};

		rtc {
			compatible = "ti,twl4030-rtc";
			interrupts = <11>;
		};

		/* names follow the ReconOS board file: ldo1=vpp ldo2=vaux1 ldo3=vaux3 ldo4=vaux2
		 * ldo5=vmmc(eMMC) ldo6=vcxio ldo7=vusim ldoln=vdac ldousb=vusb */
		ldo1: regulator-ldo1 {
			compatible = "ti,twl6032-ldo1";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <2500000>;
		};

		ldo2: regulator-ldo2 {
			compatible = "ti,twl6032-ldo2";
			regulator-always-on;
			regulator-boot-on;
			regulator-min-microvolt = <1000000>;
			regulator-max-microvolt = <3000000>;
		};

		ldo3: regulator-ldo3 {
			compatible = "ti,twl6032-ldo3";
			regulator-always-on;
			regulator-boot-on;
			regulator-min-microvolt = <1000000>;
			regulator-max-microvolt = <3000000>;
		};

		ldo4: regulator-ldo4 {
			compatible = "ti,twl6032-ldo4";
			regulator-always-on;
			regulator-boot-on;
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <2800000>;
		};

		ldo5: regulator-ldo5 {
			compatible = "ti,twl6032-ldo5";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <3000000>;
			regulator-always-on;	/* eMMC */
			ti,retain-on-reset;
		};

		ldo6: regulator-ldo6 {
			compatible = "ti,twl6032-ldo6";
			regulator-always-on;
		};

		ldo7: regulator-ldo7 {
			compatible = "ti,twl6032-ldo7";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <2900000>;
		};

		ldoln: regulator-ldoln {
			compatible = "ti,twl6032-ldoln";
			regulator-always-on;
		};

		ldousb: regulator-ldousb {
			compatible = "ti,twl6032-ldousb";
			regulator-always-on;
		};

		vio: regulator-vio {
			compatible = "ti,twl6032-vio";
			regulator-always-on;
		};

		twl_usb_comparator: usb-comparator {
			compatible = "ti,twl6030-usb";
			interrupts = <4>, <10>;
		};

		twl_pwm: pwm {
			compatible = "ti,twl6030-pwm";
			#pwm-cells = <2>;
		};

		twl_pwmled: pwmled {
			compatible = "ti,twl6030-pwmled";
			#pwm-cells = <2>;
		};

		gpadc: gpadc {
			compatible = "ti,twl6032-gpadc";
			interrupts = <3>;
			#io-channel-cells = <1>;
		};
	};
};

#include "twl6030_omap4.dtsi"

&twl_usb_comparator {
	usb-supply = <&ldousb>;
};

&mmc1 {
	status = "disabled";	/* sdmmc1 pads are in safe mode on the Jet */
};

&mmc2 {
	pinctrl-names = "default";
	pinctrl-0 = <&mmc2_pins>;
	vmmc-supply = <&ldo5>;
	bus-width = <8>;
	non-removable;
	no-sd;
	no-sdio;
};

&mmc3 {
	status = "disabled";
};

&mmc4 {
	status = "disabled";
};

&mmc5 {
	/* WL128x SDIO. Stock board file: ref clock 26 MHz, tcxo 26 MHz, IRQ gpio_53, EN gpio_43 */
	pinctrl-names = "default";
	pinctrl-0 = <&wl12xx_pins>;
	vmmc-supply = <&wl12xx_vmmc>;
	interrupts-extended = <&wakeupgen GIC_SPI 59 IRQ_TYPE_LEVEL_HIGH
			       &omap4_pmx_core 0x10e>;
	non-removable;
	bus-width = <4>;
	cap-power-off-card;
	status = "okay";

	#address-cells = <1>;
	#size-cells = <0>;
	wlcore: wlcore@2 {
		compatible = "ti,wl1283";
		reg = <2>;
		interrupts-extended = <&gpio2 21 IRQ_TYPE_LEVEL_HIGH>,
				      <&omap4_pmx_core 0x3a>;
		interrupt-names = "irq", "wakeup";
		ref-clock-frequency = <26000000>;
		tcxo-clock-frequency = <26000000>;
	};
};

&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart2_pins>;
	interrupts-extended = <&wakeupgen GIC_SPI 73 IRQ_TYPE_LEVEL_HIGH
			       &omap4_pmx_core OMAP4_UART2_RX>;

	bluetooth {
		compatible = "ti,wl1283-st";
		pinctrl-names = "default";
		pinctrl-0 = <&bt_pins>;
		enable-gpios = <&gpio2 14 GPIO_ACTIVE_HIGH>;	/* GPIO_46 */
		clocks = <&twl 0>;
		clock-names = "ext_clock";
	};
};

&mcbsp2 {
	pinctrl-names = "default";
	pinctrl-0 = <&mcbsp2_pins>;
	#sound-dai-cells = <0>;
	status = "okay";
};

/* stock during tinycap: DMIC clkctrl 0x01000002 (fclk = pad_clks, i.e. fref_clk2_out 19.2 MHz looped
 * back on the abe_clks pad), mic clock generated by the DMIC block. Mainline just uses the block's own
 * fclk (abe_24m / sys clk, same crystal); no AUXCLK2 needed. */
&dmic {
	pinctrl-names = "default";
	pinctrl-0 = <&dmic_pins>;
	#sound-dai-cells = <0>;
	status = "okay";
};

&uart3 {
	status = "disabled";	/* uart3_rx pad is BUTTON_1; no console wired out */
};

/* sensor buses (stock board-jet-sensors.c): i2c2 = LSM9DS0 (0x1d or 0x1e / gyro 0x6a or 0x6b
 * depending on the board revision) + LPS25H 0x5d + APDS9900 0x39 (no mainline driver);
 * i2c3 = MFi 0x11 + TFA98xx amp 0x34; i2c4 = TMP102 0x49 + Partron OFM touchpad 0x53 + MT9M114 0x48 */
&i2c2 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_pins>;
	clock-frequency = <400000>;
	status = "okay";

	/* probed 2026-10-17: accel/mag at 0x1d, gyro at 0x6b (so this is a JET_V2 board) */
	imu@1d {
		compatible = "st,lsm9ds0-imu";
		reg = <0x1d>;
		vdd-supply = <&ldo4>;
		vddio-supply = <&ldo4>;
	};
	gyro@6b {
		compatible = "st,lsm9ds0-gyro";
		reg = <0x6b>;
		vdd-supply = <&ldo4>;
		vddio-supply = <&ldo4>;
	};

	/* glance sensor: Avago APDS9900 ALS+proximity (ID 0x29). Mainline's tsl2772 driver accepts it
	 * as a tmd2771 (same register family, 0x2x ID); IIO in_proximity0_raw ~800 idle. Stock wired its
	 * INT to gpio 56; polled for now. */
	glance: proximity@39 {
		compatible = "amstaos,tmd2771";
		reg = <0x39>;
		led-max-microamp = <25000>;	/* 100 mA default saturated (1023) looking away; less IR, less glare */
		vdd-supply = <&ldo4>;
		vddio-supply = <&ldo4>;
	};
	pressure@5d {
		compatible = "st,lps25h-press";
		reg = <0x5d>;
		vdd-supply = <&ldo4>;
		vddio-supply = <&ldo4>;
	};
};

&i2c3 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3_pins>;
	clock-frequency = <400000>;
	status = "okay";

	/* speaker amp: NXP TFA9895 (revision reg 0x03 = 0x12). Mainline tfa989x drives it as a plain
	 * I2S codec without the DSP tuning Android loaded with NXP's climax tool. */
	tfa9895: amplifier@34 {
		compatible = "nxp,tfa9895";
		reg = <0x34>;
		#sound-dai-cells = <0>;
	};
};

/ {
	cam_switch: regulator-cam-switch {
		compatible = "regulator-fixed";
		regulator-name = "cam_switch";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		gpio = <&gpio6 15 GPIO_ACTIVE_HIGH>;	/* gpio_175 SW_CAM_ON */
		enable-active-high;
		startup-delay-us = <10000>;
	};
};

&i2c4 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c4_pins>;
	clock-frequency = <400000>;
	status = "okay";

	temp@49 {
		compatible = "ti,tmp102";
		reg = <0x49>;
	};

	camera@48 {
		compatible = "onnn,mt9m114";
		reg = <0x48>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_pins>;
		clocks = <&auxclk1_ck>;
		/* EXTCLK 19.2 MHz = sys_clkin / 2 (the bootloader left auxclk1 on dpll_per_m3x2 / 8 = 32 MHz);
		 * with the sensor PLL (m32 n1 p7) pixrate = 2 x EXTCLK = 38.4 MHz, CSI-2 link = pixrate x 8 */
		assigned-clocks = <&auxclk1_src_ck>, <&auxclk1_ck>;
		assigned-clock-parents = <&sys_clkin_ck>;
		assigned-clock-rates = <0>, <19200000>;
		reset-gpios = <&gpio3 19 GPIO_ACTIVE_LOW>;	/* gpio_83 cam_globalreset */
		vdd-supply = <&cam_switch>;
		vddio-supply = <&cam_switch>;
		vaa-supply = <&cam_switch>;

		port {
			cam_out: endpoint {
				remote-endpoint = <&iss_csi2a_in>;
				bus-type = <4>;		/* MIPI CSI-2 D-PHY */
				clock-lanes = <1>;
				data-lanes = <2>;
				link-frequencies = /bits/ 64 <307200000>;	/* 19.2 MHz EXTCLK, PLL on: pixrate 38.4 MHz x 8 */
			};
		};
	};

	touchpad@53 {
		compatible = "partron,ms37c01a";
		reg = <0x53>;
		pinctrl-names = "default";
		pinctrl-0 = <&ofm_pins>;
		interrupts-extended = <&gpio6 16 IRQ_TYPE_LEVEL_HIGH>;
		standby-gpios = <&gpio2 17 GPIO_ACTIVE_HIGH>;
		powerdown-gpios = <&gpio2 5 GPIO_ACTIVE_HIGH>;
		vdd-supply = <&ldo2>;
	};
};

&usb_otg_hs {
	pinctrl-names = "default";
	pinctrl-0 = <&usb_otg_hs_pins>;
	interface-type = <1>;
	mode = <3>;
	power = <50>;
};

&usbhshost {
	status = "disabled";
};

&dss {
	status = "okay";
};

&rfbi {
	compatible = "ti,omap4-rfbi";
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&rfbi_pins>;

	port {
		rfbi_out: endpoint {
			remote-endpoint = <&kopin_in>;
		};
	};
};

/* OMAP4 ISS (camera subsystem): child of omap4.dtsi's target-module@52000000, driver in
 * kernel/overlay/drivers/media/platform/ti/omap4iss (resurrected from v6.6 staging + DT glue).
 * Register blocks in the driver's enum order; CONTROL_CAMERA_RX is syscon offset 0x68. */
&{/ocp/target-module@52000000} {
	iss: iss@0 {
		compatible = "ti,omap4-iss";
		reg = <0x00000 0x100>,
		      <0x01000 0x170>,
		      <0x01170 0x020>,
		      <0x01400 0x170>,
		      <0x01570 0x020>,
		      <0x02000 0x0a0>,
		      <0x10000 0x0a0>,
		      <0x10400 0x400>,
		      <0x10800 0x800>,
		      <0x11000 0x200>,
		      <0x11200 0x200>;
		reg-names = "top", "csi2_a_regs1", "camerarx_core1", "csi2_b_regs1", "camerarx_core2",
			    "bte", "isp_sys1", "isp_resizer", "isp_ipipe", "isp_isif", "isp_ipipeif";
		interrupts = <GIC_SPI 24 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&iss_clkctrl OMAP4_ISS_CLKCTRL 0>, <&iss_clkctrl OMAP4_ISS_CLKCTRL 8>;
		clock-names = "iss_fck", "iss_ctrlclk";
		syscon = <&omap4_padconf_global>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				iss_csi2a_in: endpoint {
					remote-endpoint = <&cam_out>;
					clock-lanes = <1>;
					data-lanes = <2>;
				};
			};
		};
	};
};
