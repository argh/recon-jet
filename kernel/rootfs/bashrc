# ~/.bashrc for the Jet's rootfs (kernel/rootfs/Dockerfile bakes it): colour on the glass
# terminal and over ssh, --color=auto everywhere so pipes stay clean. jetd's VT (TERM=linux)
# renders the Linux-console escapes; egrep/fgrep go through `grep -E/-F` to dodge the
# obsolescence warning the wrappers print.
eval "$(dircolors -b)" 2>/dev/null
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias egrep='grep -E --color=auto'
alias fgrep='grep -F --color=auto'
alias diff='diff --color=auto'
alias ip='ip -color=auto'
alias dmesg='dmesg --color=auto'
export LESS=-R
PS1='\[\e[32m\]\u@\h\[\e[0m\]:\[\e[94m\]\w\[\e[0m\]\$ '
# Debian keeps games out of root's PATH (/etc/profile), and root is the only user here: without
# this, `apt-get install nethack-console` succeeds and `nethack` is "command not found"
case ":$PATH:" in *:/usr/games:*) ;; *) PATH=$PATH:/usr/local/games:/usr/games ;; esac
