# Kconfig fragment merged on top of omap2plus_defconfig for the Recon Jet (OMAP4430).
# First milestone: boot to a busybox initramfs with USB gadget serial + RNDIS, no display.
CONFIG_ARCH_OMAP4=y
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_EXTEND=y
# USB peripheral on MUSB with a composite gadget we can configure from the initramfs
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_OMAP2PLUS=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_G_SERIAL=n
CONFIG_NOP_USB_XCEIV=y
CONFIG_OMAP_USB2=y
CONFIG_TWL6030_USB=y
# PMIC / power
CONFIG_TWL6030_GPADC=y
CONFIG_CHARGER_TWL6030=y
CONFIG_INPUT_TWL6040_VIBRA=n
# storage
CONFIG_MMC_OMAP_HS=y
CONFIG_EXT4_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# early debug on UART3 (ttyO2) in case the console pads ever get wired
CONFIG_DEBUG_LL=y
CONFIG_DEBUG_OMAP4UART3=y
CONFIG_EARLY_PRINTK=y
# watchdog that actually resets on a hang (no in-kernel petting)
CONFIG_OMAP_WATCHDOG=y
CONFIG_WATCHDOG_NOWAYOUT=y
# keep the image small
CONFIG_DRM=n
# display: old omapfb stack (DSS core + DISPC) with RFBI re-added and the Kopin panel driver;
# omapfb exposes /dev/fb0 + OMAPFB_UPDATE_WINDOW exactly like the stock kernel
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_FB_OMAP2=y
CONFIG_FB_OMAP2_DSS=y
CONFIG_FB_OMAP2_DSS_RFBI=y
CONFIG_FB_OMAP2_DSS_DEBUGFS=y
CONFIG_FB_OMAP2_NUM_FBS=1
CONFIG_FB_OMAP2_PANEL_KOPIN_A230=m
CONFIG_INPUT_JET_OFM=m
CONFIG_FB_OMAP2_DSS_DPI=n
CONFIG_FB_OMAP2_DSS_DSI=n
CONFIG_FB_OMAP4_DSS_HDMI=n
CONFIG_FB_OMAP2_DSS_VENC=n
CONFIG_FB_OMAP2_DSS_SDI=n
CONFIG_SOUND=n
# WiFi: WL128x on mmc5 via wlcore (fw wl128x-fw-5-*.bin in the initramfs /lib/firmware)
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_TI=y
CONFIG_WL12XX=y
CONFIG_WLCORE=y
CONFIG_WLCORE_SDIO=y
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_BT=n
# make the USB/PMIC pieces built-in (defconfig has them as modules; no module loading in the initramfs)
CONFIG_USB_MUSB_OMAP2PLUS=y
CONFIG_TWL6030_USB=y
CONFIG_TWL6030_GPADC=y
CONFIG_CHARGER_TWL6030=y
CONFIG_INPUT_TWL4030_PWRBUTTON=y
CONFIG_USB_OTG=y
CONFIG_SERIAL_8250_OMAP_TTYO_FIXUP=y
CONFIG_CMDLINE=""
CONFIG_CMDLINE_EXTEND=y
# base subsystems the defconfig leaves as modules; needed built-in for the initramfs boot
CONFIG_USB=y
CONFIG_IIO=y
CONFIG_CLK_TWL=y
CONFIG_RTC_DRV_TWL4030=y
CONFIG_PWM_TWL=y
CONFIG_PWM_TWL_LED=y
# cpufreq-dt must be built in (defconfig has =m): OMAP4 OPPs via ti-cpufreq
CONFIG_CPUFREQ_DT=y
# hardware RNG: dropbear otherwise waits minutes for the crng (no jitter entropy source at idle)
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_OMAP=y
# buttons + sensors (M2): gpio-keys for BUTTON_1, ST IMU/gyro/pressure on i2c2, TMP102 on i2c4, i2c-dev for probing
CONFIG_KEYBOARD_GPIO=y
CONFIG_I2C_CHARDEV=y
CONFIG_IIO_ST_LSM9DS0=y
CONFIG_IIO_ST_LSM9DS0_I2C=y
CONFIG_IIO_ST_GYRO_3AXIS=y
CONFIG_IIO_ST_GYRO_I2C_3AXIS=y
CONFIG_IIO_ST_PRESS=y
CONFIG_IIO_ST_PRESS_I2C=y
CONFIG_HWMON=y
CONFIG_SENSORS_TMP102=y
# evdev nodes for gpio-keys (defconfig has it as a module)
CONFIG_INPUT_EVDEV=y
# no text console on the glass: fbcon cursor-blink work deadlocks the manual-update panel on reboot
CONFIG_FRAMEBUFFER_CONSOLE=n
CONFIG_LOGO=n
# no virtual terminals at all (fbcon is forced on while VT is set)
CONFIG_VT=n
# crash capture across resets + reboot on panic
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PANIC_TIMEOUT=5
# no serial console: the kernel otherwise registers ttyS0 (UART2, not wired) and spends ~20 s replaying the log into it at boot
# CONFIG_SERIAL_8250_CONSOLE is not set

# camera: OMAP4 ISS (overlay driver, module) + MT9M114 sensor, V4L2 core built in (no modprobe on the Jet)
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=n
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_V4L2_SUBDEV_API=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_VIDEOBUF2_CORE=y
CONFIG_VIDEOBUF2_V4L2=y
CONFIG_VIDEOBUF2_DMA_CONTIG=y
CONFIG_V4L2_FWNODE=y
CONFIG_V4L2_ASYNC=y
# omap3isp built in only to pull VIDEOBUF2/V4L2_FWNODE built in (non-visible symbols follow their
# selectors); it never probes on the Jet. The ISS driver itself stays a module for iteration.
CONFIG_VIDEO_OMAP3=y
CONFIG_VIDEO_OMAP4=m
CONFIG_VIDEO_MT9M114=y

# glance sensor: APDS9900 at i2c2 0x39, ID 0x29 matches the tsl2771 family check in tsl2772.c
CONFIG_IIO=y
CONFIG_TSL2772=m

# power-button LED on TWL6032 PWM2 (pwm-twl is built in)
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_PWM=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_TIMER=y

# Bluetooth: WL1283 HCI over UART2 (TI HCI-LL serdev, firmware TIInit_*.bts). Modules on userdata.
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_HIDP=m
CONFIG_UHID=m
CONFIG_BT_LE=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_LL=y
# Audio: McBSP2 I2S -> NXP TFA9895 speaker amp (i2c3 0x34); OMAP DMIC mics. Modules on userdata.
CONFIG_SOUND=m
CONFIG_SND=m
CONFIG_SND_PCM=m
CONFIG_SND_TIMER=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_OMAP_MCBSP=m
CONFIG_SND_SOC_OMAP_DMIC=m
CONFIG_SND_SIMPLE_CARD=m
CONFIG_SND_SOC_TFA989X=m
CONFIG_SND_SOC_DMIC=m
# WireGuard: off-home auto-VPN (docs/vpn.md). Built as a module so wg-quick modprobes it on demand;
# its crypto/UDP-tunnel deps are pulled in by Kconfig select + olddefconfig.
CONFIG_WIREGUARD=m
